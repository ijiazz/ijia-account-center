{
  "tasks": {
    "check:type": "deno check",
    "check:fmt": "deno fmt --check",
    "fmt": "deno fmt",
    "test": "deno x vitest run"
  },
  "nodeModulesDir": "manual",
  "imports": {
    "@asla/hofetch": "jsr:@asla/hofetch@^0.0.2",
    "@asla/wokao": "jsr:@asla/wokao@^0.0.3",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.2",
    "@std/cache": "jsr:@std/cache@^0.2.3",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "@types/nodemailer": "npm:@types/nodemailer@^8.0.0",
    "evlib": "jsr:@asn/evlib@^3.1.3",
    "@redis/client": "npm:@redis/client@^5.12.1",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.2",
    "hono": "jsr:@hono/hono@^4.12.18",
    "@asla/pg": "npm:@jsr/asla__pg@^0.2.4",
    "@asla/yoursql": "npm:@jsr/asla__yoursql@0.14.0",
    "@ijia/school-db": "npm:@jsr/ijia__school-db@^0.0.2-beta.0",
    "nodemailer": "npm:nodemailer@^8.0.7",

    "@ijia/account-dto": "jsr:@ijia/account-dto@^0.0.0",

    "@/": "./src/",
    "#test/": "./test/",
    "vite": "npm:vite@^8.0.13",
    "vitest": "npm:vitest@^4.1.6"
  },
  "fmt": {
    "lineWidth": 120
  },
  "lint": {
    "rules": {
      "exclude": ["require-await"]
    }
  },
  "links": ["../dto"]
}
