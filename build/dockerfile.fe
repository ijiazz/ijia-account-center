FROM denoland/deno:debian-2.7.14 AS build
ENV DENO_DIR=/deno-dir

WORKDIR /build

# core-js postinstall 依赖 node 环境
COPY --from=node:26-bookworm-slim /usr/local/bin/node /usr/local/bin/node 
COPY --from=node:26-bookworm-slim /usr/lib/x86_64-linux-gnu/libatomic.so.1 /usr/lib/x86_64-linux-gnu/libatomic.so.1

ADD dto/deno.jsonc ./dto/
ADD fe/deno.jsonc fe/deno.lock ./fe/

WORKDIR /build/fe
RUN --mount=type=cache,target=/deno-dir deno install --frozen

WORKDIR /build

ADD ./dto/src ./dto/src

ADD ./fe/index.html ./fe/vite.config.ts ./fe/
ADD ./fe/public ./fe/public
ADD ./fe/src ./fe/src

WORKDIR /build/fe
RUN deno task build


FROM nginx:1.26-alpine
WORKDIR /serve/web
ADD ./build/nginx/nginx.conf /etc/nginx/nginx.conf
ADD ./build/nginx/conf.d /etc/nginx/conf.d

ADD ./build/nginx/localhost.crt /tls.crt
ADD ./build/nginx/localhost.key /tls.key

COPY --from=build /build/fe/dist .
EXPOSE 443

